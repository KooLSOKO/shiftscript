{
  "name": "shiftscript",
  "version": "3.0.11",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web \"node --watch server/index.js\" \"vite --host 127.0.0.1\"",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "start": "node server/index.js",
    "test": "node --test tests/*.test.js",
    "check": "npm test && npm run build",
    "test:ui": "node tests/browser-smoke.js && node tests/accounts-browser.js && node tests/collaboration-browser.js && node tests/integrations-browser.js && node tests/productivity-browser.js && node tests/public-pages-browser.js && node tests/landing-browser.js && node tests/dashboard-browser.js && node tests/experience-browser.js",
    "format": "prettier --write src server shared api tests"
  },
  "dependencies": {
    "@google/genai": "^2.28.0",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "firebase": "^12.0.0",
    "firebase-admin": "^13.4.0",
    "jspdf": "^4.2.1",
    "nodemailer": "^10.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tailwindcss/vite": "^4.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.0",
    "prettier": "^3.9.9",
    "supertest": "^7.1.0",
    "tailwindcss": "^4.1.0",
    "vite": "^7.0.0"
  }
}
