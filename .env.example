# Works immediately with fictional sample, even before Firebase is connected.
STORAGE_MODE=local
AI_PROVIDER=sample
PORT=3001
# Enable real transcript analysis and voice by changing AI_PROVIDER to gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Transcription and analysis each consume one request; failures count too.
MAX_ANALYSES_PER_DAY=20
# Switch to firebase after enabling Firestore/Auth and setting Admin credentials.
FIREBASE_PROJECT_ID=shiftscriptza
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_SERVICE_ACCOUNT_JSON=
ALLOWED_EMAILS=
# true enables signup for invited teammates; workspace membership still protects data.
# false keeps the original ALLOWED_EMAILS access restriction.
PUBLIC_SIGNUP_ENABLED=false
# Your public Firebase Web app config is prefilled (also in src/firebase-config.js).
VITE_FIREBASE_API_KEY=AIzaSyCaDbvJfXBm3y8BOmykiWfHjEylJ0vDIFM
VITE_FIREBASE_AUTH_DOMAIN=shiftscriptza.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=shiftscriptza
VITE_FIREBASE_APP_ID=1:604600757134:web:f18af972af922bbf3152df

# Google Meet + Docs imports. Server only: never prefix these with VITE_.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://shiftscript.earny.co.za/api/google/callback
# Generate once: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep this stable. Changing it makes existing encrypted connections unreadable.
INTEGRATION_ENCRYPTION_KEY=

# Earny Zoho SMTP. Use the exact hostname shown in YOUR Zoho account.
# SMTP access must be included in your Zoho plan. 465=SSL, 587=STARTTLS.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# Optional verified sending alias; otherwise SMTP_USER is used.
SMTP_FROM=
